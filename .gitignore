# Dependencias: se reinstalan con `npm install` en cada equipo
node_modules/

# Base de datos local: datos de operación, NO de código.
#
# Se queda fuera del repositorio por una razón concreta: durante el evento este
# archivo contiene las ventas reales de la tablet. Si estuviera versionado, un
# `git pull` para traer un arreglo de código intentaría sobreescribirlo. Git no
# sabe fusionar un binario, solo reemplazarlo.
#
# En el primer arranque el servidor la crea y la siembra solo (barras, cajeros,
# meseros, categorías, productos y métodos de pago). La semilla vive dentro de
# server.js, así que ESA sí viaja por git.
#
# Para respaldarla o llevarla a otro equipo: detén el servidor con Ctrl+C y
# copia únicamente pos_evento.db. Al cerrarse vuelca el -wal dentro del .db y
# lo deja completo. Copiarlo con el servidor encendido da una base a medias.
pos_evento.db
pos_evento.db-wal
pos_evento.db-shm
*.db-journal

# Copias desechables que crean las herramientas de tools/ para castigarlas sin
# miedo. Se rehacen solas en cada ejecución.
pos_evento.stress.db*
pos_evento.logic.db*
pos_evento.ui.db*
# Bases de cada barra cuando se prueban varias instancias en el mismo equipo.
barra_*.db*
pos_evento.dos.db*

# Configuración por equipo. PORT y MESERO_PIN_SCOPE tienen valores por defecto,
# así que la app arranca igual sin este archivo.
.env

# Copia antigua e incompleta del proyecto que quedó anidada por error
/masterdrinks/

# Basura del sistema
Thumbs.db
desktop.ini
.DS_Store
